/* Global solid background #384959 */
body, .hero, .site-header, main, section, header, canvas {
  background-color: #384959 !important;
  background-image: none !important; }

canvas, #particles-js, .particles-js-canvas-el, .bg-animation {
  display: none !important;
  visibility: hidden !important; }

/* Force full width across navigation header wrappers */
header,
.site-header,
nav,
.container {
  max-width: 100% !important;
  width: 100% !important;
  margin: 0 !important;
  padding: 0 !important;
  box-sizing: border-box !important; }

/* Header container layout */
.nav-container {
  display: flex;
  justify-content: space-between;
  align-items: center;
  width: 100% !important;
  padding: 1rem 0;
  position: relative; }

/* Logo positioned 5% in from the left viewport edge */
.logo {
  margin-left: 5vw !important;
  font-size: 1.5rem;
  font-weight: bold;
  color: #fff;
  text-decoration: none;
  z-index: 9997; }

/* Base Hamburger Icon Styling */
.hamburger-btn {
  background: none;
  border: none;
  font-size: 1.8rem;
  color: #fff;
  cursor: pointer;
  padding: 0.5rem; }

/* Static trigger icon on the far right when drawer is closed */
.header-trigger {
  position: absolute !important;
  right: 1.5rem !important;
  top: 1rem !important;
  margin: 0 !important;
  z-index: 9998 !important; }

/* 30vw Off-canvas drawer sliding in from the right boundary */
.nav-dropdown {
  position: fixed !important;
  top: 0 !important;
  right: 0 !important;
  left: auto !important;
  width: 30vw !important;
  min-width: 250px !important;
  height: 100vh;
  background-color: #384959 !important;
  border-left: 1px solid rgba(255, 255, 255, 0.1);
  padding: 1.5rem;
  box-shadow: -4px 0 12px rgba(0, 0, 0, 0.3);
  z-index: 9999 !important;
  /* Hidden completely off-screen to the right by default */
  transform: translateX(100%);
  transition: transform 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  display: flex;
  flex-direction: column; }

/* Container inside drawer aligning icon to the LEFT of the drawer panel */
.drawer-header {
  display: flex;
  justify-content: flex-start;
  /* Aligns icon to top-left of the drawer */
  width: 100%;
  margin-bottom: 2rem; }

/* Icon inside drawer */
.drawer-trigger {
  color: #fff; }

/* Slide into view when active */
.nav-dropdown.active {
  transform: translateX(0) !important; }

/* Nav links inside drawer */
.nav-links {
  list-style: none;
  padding: 0;
  margin: 0;
  display: flex;
  flex-direction: column;
  gap: 1.25rem; }

.nav-links a {
  text-decoration: none;
  color: #fff;
  font-size: 1.1rem;
  transition: color 0.2s ease; }

.nav-links a:hover,
.nav-links a[aria-current="true"] {
  color: #88bcd4;
  text-decoration: underline; }
