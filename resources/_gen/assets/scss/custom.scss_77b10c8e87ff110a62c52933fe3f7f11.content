body,.hero,.site-header,main,section,header,canvas{background-color:#384959!important;background-image:none!important}canvas,#particles-js,.particles-js-canvas-el,.bg-animation{display:none!important;visibility:hidden!important}header,.site-header,nav,.container{max-width:100%!important;width:100%!important;margin:0!important;padding:0!important;box-sizing:border-box!important}.nav-container{display:flex;justify-content:space-between;align-items:center;width:100%!important;padding:1rem 0;position:relative}.logo{margin-left:5vw!important;font-size:1.5rem;font-weight:700;color:#fff;text-decoration:none;z-index:9997}.hamburger-btn{background:0 0;border:none;font-size:1.8rem;color:#fff;cursor:pointer;padding:.5rem}.header-trigger{position:absolute!important;right:1.5rem!important;top:1rem!important;margin:0!important;z-index:9998!important}.nav-dropdown{position:fixed!important;top:0!important;right:0!important;left:auto!important;width:30vw!important;min-width:250px!important;height:100vh;background-color:#384959!important;border-left:1px solid rgba(255,255,255,.1);padding:1.5rem;box-shadow:-4px 0 12px rgba(0,0,0,.3);z-index:9999!important;transform:translateX(100%);transition:transform .3s cubic-bezier(.4,0,.2,1);display:flex;flex-direction:column}.drawer-header{display:flex;justify-content:flex-start;width:100%;margin-bottom:2rem}.drawer-trigger{color:#fff}.nav-dropdown.active{transform:translateX(0)!important}.nav-links{list-style:none;padding:0;margin:0;display:flex;flex-direction:column;gap:1.25rem}.nav-links a{text-decoration:none;color:#fff;font-size:1.1rem;transition:color .2s ease}.nav-links a:hover,.nav-links a[aria-current=true]{color:#88bcd4;text-decoration:underline}